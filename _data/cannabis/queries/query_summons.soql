SELECT date_extract_y(summons_date) AS year, precinct_of_occur AS precinct, count(*) AS n WHERE (upper(offense_description) like '%MARIJ%' OR upper(offense_description) like '%MARIG%' OR upper(offense_description) like '%MARJU%' OR upper(offense_description) like '%CANNABIS%') AND upper(offense_description) not like '%THETIC%' GROUP BY year, precinct ORDER BY year, precinct LIMIT 50000
