SELECT precinct_of_occur AS precinct, CASE(summons_date < '2021-03-31T00:00:00', 'pre_2021-01-01_to_2021-03-30', summons_date >= '2021-03-31T00:00:00', 'post_2021-03-31_to_2021-12-31') AS period, count(*) AS n WHERE summons_date between '2021-01-01T00:00:00' and '2021-12-31T23:59:59' AND (upper(offense_description) like '%MARIJ%' OR upper(offense_description) like '%MARIG%' OR upper(offense_description) like '%MARJU%' OR upper(offense_description) like '%CANNABIS%') AND upper(offense_description) not like '%THETIC%' GROUP BY precinct, period ORDER BY precinct LIMIT 50000
