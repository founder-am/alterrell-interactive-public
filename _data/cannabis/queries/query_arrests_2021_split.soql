SELECT arrest_precinct AS precinct, CASE(arrest_date < '2021-03-31T00:00:00', 'pre_2021-01-01_to_2021-03-30', arrest_date >= '2021-03-31T00:00:00', 'post_2021-03-31_to_2021-12-31') AS period, CASE(law_code like 'PL 221%', 'PL221', law_code like 'PL 222%', 'PL222') AS article, count(*) AS n WHERE arrest_date between '2021-01-01T00:00:00' and '2021-12-31T23:59:59' AND (law_code like 'PL 221%' OR law_code like 'PL 222%') AND (pd_cd IS NULL OR pd_cd != '781') GROUP BY precinct, period, article ORDER BY precinct LIMIT 50000
