---
/**
 * SodiumPicker — the swap calculator from the archived Fast Food Sodium piece.
 *
 * Ported 2026-08-16 from _archive/legacy-2026-08-13/fast-food-sodium/index.html,
 * where it lived in the "Compare Your Order" tab (<section id="compare">, archive
 * lines 1072-1152) with its logic at archive lines 1770-1925 and its data in the
 * MENU literal at archive lines 1480-1656.
 *
 * SODIUM-SPECIFIC, not generic. Ruled by AMA 2026-08-16. Every selector this
 * component uses is scoped under .sodium-picker so that .comp-card, .nutrient
 * and friends can never collide with a future platform component of the same
 * name. The class names inside that scope are the archive's own.
 *
 * This file carries ZERO CSS rules, for the same reason [slug].astro and
 * index.astro do: Astro scopes a component's scoped-style block with
 * [data-astro-cid-*], which adds a class-level unit of specificity and outranks
 * the shared stylesheet. That is what forced the no-op-selector specificity hack
 * Batch A removed. Every rule lives in src/styles/alterrell-interactive.css,
 * section 21.
 *
 * Data crosses to the browser on a data- attribute, not define:vars, which opts
 * the script out of bundling. The JSON is read once from src/data/sodium-items.json
 * at build time and parsed once at runtime.
 *
 * No framework. astro.config.mjs registers exactly one integration, mdx(), and
 * no renderer is installed, so a client: directive would have nothing to hydrate
 * with. Interactivity is a plain <script is:inline>, the same mechanism
 * Carousel.astro and pieces/[slug].astro use.
 */
import data from '../data/sodium-items.json';

const { MENU } = data;
/** Chain order is the archive's MENU key order, which is its <select> order. */
const chains = Object.entries(MENU).map(([key, chain]) => ({ key, name: (chain as any).name }));
---
<div class="sodium-picker" data-sodium={JSON.stringify(data)}>

  <div class="calc-section">
    <p class="ai-label">Step 1 &mdash; What do you usually order?</p>
    <div class="calc-selectors">
      <div>
        <label class="ai-label" for="chain-select">Chain</label>
        <select class="ai-select" id="chain-select">
          <option value="">Select a chain...</option>
          {chains.map((c) => <option value={c.key}>{c.name}</option>)}
        </select>
      </div>
      <div>
        <label class="ai-label" for="item-select">Item</label>
        <select class="ai-select" id="item-select">
          <option value="">Select chain first...</option>
        </select>
      </div>
    </div>

    <p class="ai-label calc-step-2">Step 2 &mdash; What kind of swap?</p>
    <div class="calc-mode-btns" role="group" aria-label="Swap type">
      <button type="button" class="calc-mode-btn active" data-mode="both">Show both options</button>
      <button type="button" class="calc-mode-btn" data-mode="samechain">Same chain only</button>
      <button type="button" class="calc-mode-btn" data-mode="crosschain">Any chain</button>
    </div>

    <button type="button" class="calc-find-btn" id="calc-find">Find a Better Swap &rarr;</button>

    <div id="calc-results" class="calc-results" role="status" aria-live="polite"></div>
  </div>

</div>

<script is:inline>
(function () {
  var root = document.querySelector('.sodium-picker');
  if (!root) return;

  var data = JSON.parse(root.dataset.sodium);
  var MENU = data.MENU;
  var DAILY_SODIUM = data.DAILY_SODIUM;
  var DAILY_FIBER = data.DAILY_FIBER;

  var chainSel = root.querySelector('#chain-select');
  var itemSel  = root.querySelector('#item-select');
  var findBtn  = root.querySelector('#calc-find');
  var results  = root.querySelector('#calc-results');
  var calcMode = 'both';

  // ── swap search. Same category, lower sodium, lowest wins. ──
  function findSameChainSwap(chainKey, item) {
    return MENU[chainKey].items
      .filter(function (i) { return i.cat === item.cat && i.sodium < item.sodium; })
      .sort(function (a, b) { return a.sodium - b.sodium; })[0] || null;
  }

  function findCrossChainSwap(chainKey, item) {
    var candidates = [];
    Object.keys(MENU).forEach(function (key) {
      if (key === chainKey) return;
      MENU[key].items.forEach(function (i) {
        if (i.cat === item.cat && i.sodium < item.sodium) {
          candidates.push({
            chainKey: key, chainName: MENU[key].name,
            id: i.id, label: i.label, cat: i.cat,
            sodium: i.sodium, fiber: i.fiber, protein: i.protein
          });
        }
      });
    });
    return candidates.sort(function (a, b) { return a.sodium - b.sodium; })[0] || null;
  }

  // ── banding. 40% and 65% of the daily limit, the archive's thresholds. ──
  function sodiumClass(mg) {
    var p = mg / DAILY_SODIUM;
    return p >= 0.65 ? 'high' : p >= 0.40 ? 'med' : 'low';
  }
  function barClass(mg) {
    var p = mg / DAILY_SODIUM;
    return p >= 0.65 ? 'sodium-high' : p >= 0.40 ? 'sodium-med' : 'sodium-low';
  }
  function pct(v, m) { return Math.min(100, Math.round((v / m) * 100)); }
  function meterZone(mg) {
    var p = pct(mg, DAILY_SODIUM);
    return p > 100 ? 'zone-over' : p >= 65 ? 'zone-high' : p >= 40 ? 'zone-med' : 'zone-low';
  }

  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c];
    });
  }

  function nutrientHTML(name, val, max, type) {
    var p = pct(val, max), unit = type === 'sodium' ? 'mg' : 'g';
    var cls = type === 'sodium' ? sodiumClass(val) : '';
    var barCls = type === 'sodium' ? barClass(val) : 'fiber';
    return '<div class="nutrient">' +
      '<div class="nutrient-row">' +
        '<span class="nutrient-name">' + esc(name) + '</span>' +
        '<div class="nutrient-vals">' +
          '<span class="nutrient-val ' + cls + '">' + val.toLocaleString() + unit + '</span>' +
          '<span class="nutrient-pct">' + p + '% daily</span>' +
        '</div>' +
      '</div>' +
      '<div class="bar-track"><div class="bar-fill ' + barCls + '" style="width:' + p + '%"></div></div>' +
    '</div>';
  }

  function cardHTML(chainName, item, tag, cardClass, badge) {
    return '<div class="comp-card ' + cardClass + '">' +
      '<div class="comp-card-header">' +
        '<span class="comp-card-tag">' + esc(tag) + '</span>' +
        '<span class="comp-card-badge">' + esc(badge) + '</span>' +
      '</div>' +
      '<div class="comp-card-body">' +
        '<div class="comp-card-chain">' + esc(chainName) + '</div>' +
        '<div class="comp-card-item">' + esc(item.label) + '</div>' +
        nutrientHTML('Sodium', item.sodium, DAILY_SODIUM, 'sodium') +
        nutrientHTML('Fiber', item.fiber, DAILY_FIBER, 'fiber') +
      '</div>' +
    '</div>';
  }

  function savingsCard(saved, tint, label) {
    if (saved <= 0) return '';
    var p = Math.round((saved / DAILY_SODIUM) * 100);
    return '<div class="savings-callout ' + tint + '">' +
      '<div class="savings-num">&minus;' + saved.toLocaleString() + 'mg</div>' +
      '<div class="savings-lbl"><strong>' + p + '% of your daily sodium limit</strong> ' + esc(label) + '</div>' +
    '</div>';
  }

  function populateItems() {
    var k = chainSel.value;
    itemSel.innerHTML = '';
    if (!k) {
      itemSel.innerHTML = '<option value="">Select chain first...</option>';
      results.classList.remove('visible');
      return;
    }
    itemSel.innerHTML = '<option value="">Select an item...</option>';
    MENU[k].items.forEach(function (i) {
      var o = document.createElement('option');
      o.value = i.id;
      o.textContent = i.label;
      itemSel.appendChild(o);
    });
    results.classList.remove('visible');
  }

  function findSwap() {
    var chainKey = chainSel.value;
    var itemId = itemSel.value;
    if (!chainKey || !itemId) {
      results.innerHTML = '<div class="no-swap"><strong>Pick a chain and an item first.</strong></div>';
      results.classList.add('visible');
      return;
    }

    var item = MENU[chainKey].items.filter(function (i) { return i.id === itemId; })[0];
    var chainName = MENU[chainKey].name;
    var sameSwap = findSameChainSwap(chainKey, item);
    var crossSwap = findCrossChainSwap(chainKey, item);
    var sodiumPct = pct(item.sodium, DAILY_SODIUM);
    var origCard = cardHTML(chainName, item, 'Your Order', '', sodiumPct + '% daily Na');
    var mainHTML = '';

    if (calcMode === 'samechain') {
      var swapCard = sameSwap
        ? cardHTML(chainName, sameSwap, 'Better at ' + chainName, 'same-chain-better',
            '−' + (item.sodium - sameSwap.sodium).toLocaleString() + 'mg Na')
        : '<div class="no-swap"><strong>You&rsquo;re ordering the lowest-sodium ' + esc(item.cat) + ' at ' + esc(chainName) + '.</strong> Try &ldquo;Any chain&rdquo; to see what else is out there.</div>';
      mainHTML = '<div class="comp-grid">' + origCard + swapCard + '</div>' +
        (sameSwap ? '<div class="savings-row">' + savingsCard(item.sodium - sameSwap.sodium, 'orange-tint', 'saved — no need to change where you go.') + '</div>' : '');

    } else if (calcMode === 'crosschain') {
      var swapCard2 = crossSwap
        ? cardHTML(crossSwap.chainName, crossSwap, 'Best Across All Chains', 'better',
            '−' + (item.sodium - crossSwap.sodium).toLocaleString() + 'mg Na')
        : '<div class="no-swap"><strong>Your order is already among the lowest-sodium ' + esc(item.cat) + ' options across all chains in our database.</strong></div>';
      mainHTML = '<div class="comp-grid">' + origCard + swapCard2 + '</div>' +
        (crossSwap ? '<div class="savings-row">' + savingsCard(item.sodium - crossSwap.sodium, '', 'saved by switching to ' + crossSwap.chainName + '.') + '</div>' : '');

    } else {
      if (sameSwap && crossSwap) {
        mainHTML =
          '<div class="comp-grid">' + origCard +
            cardHTML(chainName, sameSwap, 'Stay at ' + chainName, 'same-chain-better',
              '−' + (item.sodium - sameSwap.sodium).toLocaleString() + 'mg Na') +
          '</div>' +
          '<div class="savings-row">' +
            savingsCard(item.sodium - sameSwap.sodium, 'orange-tint', 'saved — no need to change where you go.') +
            savingsCard(item.sodium - crossSwap.sodium, '', 'saved by switching to ' + crossSwap.chainName + '.') +
          '</div>' +
          '<div class="dual-label">Best swap across all chains</div>' +
          '<div class="comp-grid">' + origCard +
            cardHTML(crossSwap.chainName, crossSwap, 'Best Across All Chains', 'better',
              '−' + (item.sodium - crossSwap.sodium).toLocaleString() + 'mg Na') +
          '</div>';
      } else if (sameSwap) {
        mainHTML = '<div class="comp-grid">' + origCard +
          cardHTML(chainName, sameSwap, 'Better at ' + chainName, 'same-chain-better',
            '−' + (item.sodium - sameSwap.sodium).toLocaleString() + 'mg Na') +
          '</div><div class="savings-row">' +
          savingsCard(item.sodium - sameSwap.sodium, 'orange-tint', 'saved — no need to change where you go.') +
          '</div><div class="no-swap"><strong>No lower-sodium ' + esc(item.cat) + ' option exists at other chains</strong> in our current database.</div>';
      } else if (crossSwap) {
        mainHTML = '<div class="no-swap"><strong>' + esc(chainName) + ' doesn&rsquo;t have a lower-sodium ' + esc(item.cat) + ' option.</strong> But another chain does.</div>' +
          '<div class="comp-grid">' + origCard +
          cardHTML(crossSwap.chainName, crossSwap, 'Best Across All Chains', 'better',
            '−' + (item.sodium - crossSwap.sodium).toLocaleString() + 'mg Na') +
          '</div><div class="savings-row">' +
          savingsCard(item.sodium - crossSwap.sodium, '', 'saved by switching to ' + crossSwap.chainName + '.') +
          '</div>';
      } else {
        mainHTML = origCard +
          '<div class="no-swap"><strong>You&rsquo;re ordering one of the lowest-sodium ' + esc(item.cat) + ' options across all chains in our database.</strong> That said &mdash; no fast food is truly low-sodium. The system is the problem, not just the item.</div>';
      }
    }

    results.innerHTML =
      '<p class="calc-selection">You selected: <strong>' + esc(chainName) + ' &mdash; ' + esc(item.label) + '</strong></p>' +
      mainHTML +
      '<div class="meter-section">' +
        '<div class="meter-title">Your order as % of daily sodium limit (2,300mg)</div>' +
        '<div class="meter-track">' +
          '<div class="meter-fill ' + meterZone(item.sodium) + '" style="width:' + Math.min(100, sodiumPct) + '%"></div>' +
          '<div class="meter-threshold"><span class="meter-threshold-label">Daily limit</span></div>' +
        '</div>' +
        '<div class="meter-labels"><span>0mg</span><span>1,150mg</span><span>2,300mg</span></div>' +
      '</div>';
    results.classList.add('visible');
  }

  chainSel.addEventListener('change', populateItems);
  itemSel.addEventListener('change', function () { results.classList.remove('visible'); });
  findBtn.addEventListener('click', findSwap);

  root.querySelectorAll('.calc-mode-btn').forEach(function (btn) {
    btn.addEventListener('click', function () {
      root.querySelectorAll('.calc-mode-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      calcMode = btn.dataset.mode;
      results.classList.remove('visible');
    });
  });
})();
</script>
