---
/**
 * Dynamic piece route.
 * Each file in src/content/pieces/ with status "live" gets a URL at /{slug}/.
 * Coming-soon pieces are built too (no 404), but the hub card is not linked.
 */
import { getCollection, render } from 'astro:content';
import PieceLayout from '../../layouts/PieceLayout.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('pieces');
  return pieces.map((piece) => ({
    // In Astro v5 legacy collections, piece.id includes .mdx extension.
    // piece.slug is the clean filename-without-extension slug.
    params: { slug: (piece as any).slug ?? piece.id.replace(/\.mdx?$/, '') },
    props:  { piece },
  }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
---
<PieceLayout piece={piece}>
  <Content />
</PieceLayout>
