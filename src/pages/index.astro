---
/**
 * The hub. Rewritten 2026-08-13.
 *
 * This file carries ZERO CSS rules. Every hub style lives in section 19 of
 * src/styles/alterrell-interactive.css. Astro scopes a component <style>
 * block with a [data-astro-cid-*] attribute selector, which adds a
 * class-level unit to every rule inside it and outranks the shared
 * stylesheet — that is what forced the old id-level `body`+negated-id
 * specificity hack. No block here, no hack anywhere.
 *
 * What this page does not have, and why:
 *   breadcrumb   retired — alterrell-hq/reference/NEVER-IMPLEMENT.md
 *   eyebrow      retired — same file
 *   Watch path   retired — same file
 *   carousel     not a hub element
 *   hub journey  cut 2026-08-13; the journey block belongs to a piece
 *
 * Cards: one per .mdx in src/content/pieces, plus every entry in
 * EXTRA_CARDS. A card links only if its slug is in LINKED_SLUGS, which is
 * also the list src/pages/pieces/[slug].astro builds from, so an href can
 * never point at a page that does not exist.
 */
import { getCollection } from 'astro:content';
import '../styles/alterrell-interactive.css';
import { EXTRA_CARDS, CATEGORY_CLASS, isLinked, type HubCard } from '../lib/hub';

const collection = await getCollection('pieces');

const fromMdx: HubCard[] = collection.map((piece) => ({
  slug: (piece as any).slug ?? piece.id.replace(/\.mdx?$/, ''),
  title: piece.data.title,
  description: piece.data.description,
  stakes: piece.data.stakes,
  category: piece.data.category,
}));

// Linked pieces first, then everything still to come. Inside each group,
// alphabetical by slug, so the order is a property of the data and not of
// the order the collection happens to load in.
const bySlug = (a: HubCard, b: HubCard) => a.slug.localeCompare(b.slug);
const all = [...fromMdx, ...EXTRA_CARDS];
const cards = [
  ...all.filter((c) => isLinked(c.slug)).sort(bySlug),
  ...all.filter((c) => !isLinked(c.slug)).sort(bySlug),
];

const HUB_TITLE = 'Alterrell Interactive: Data unravels the structure.';
const HUB_DESC =
  'Alterrell Interactive builds civic and cultural data tools for people who know something is wrong but have never seen the numbers that prove it.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{HUB_TITLE}</title>
  <meta name="description" content={HUB_DESC}>
  <meta property="og:type"        content="website">
  <meta property="og:site_name"   content="Alterrell Interactive">
  <meta property="og:title"       content={HUB_TITLE}>
  <meta property="og:description" content={HUB_DESC}>
  <meta property="og:url"         content="https://interactive.alterrell.com">
  <meta property="og:image"       content="https://interactive.alterrell.com/og/hub.png">
  <meta name="twitter:card"        content="summary_large_image">
  <meta name="twitter:site"        content="@alterrell">
  <meta name="twitter:title"       content={HUB_TITLE}>
  <meta name="twitter:description" content={HUB_DESC}>
  <meta name="twitter:image"       content="https://interactive.alterrell.com/og/hub.png">
  <link rel="canonical" href="https://interactive.alterrell.com">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Spectral:ital,wght@0,700;1,700&family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,800&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body class="has-nav">

<!-- Nav. Visible at every width, 360 included. Wordmark + All pieces. -->
<nav class="ai-nav" role="navigation" aria-label="Platform navigation">
  <a href="/" class="ai-nav-brand"><span>Alterrell</span>&nbsp;Interactive</a>
  <div class="ai-nav-meta">
    <a href="#work">All pieces</a>
  </div>
</nav>

<!-- Headline wraps on text-wrap: balance. Never a <br>. -->
<header class="hub-hero" role="banner">
  <div class="hub-hero-inner">
    <h1 class="hub-hero-headline"><em>Data</em> unravels <em>the structure.</em></h1>
  </div>
</header>

<section class="hub-about">
  <div class="hub-about-inner">
    <p>{HUB_DESC}</p>
  </div>
</section>

<main id="work" class="hub-grid-section" role="main">
  <div class="hub-grid-section-inner">
    <div class="hub-piece-grid">
      {cards.map((card) => {
        const categoryClass = card.category ? CATEGORY_CLASS[card.category] : undefined;
        return isLinked(card.slug) ? (
          <a
            href={`/pieces/${card.slug}/`}
            class:list={['hub-card', 'hub-card--live', categoryClass]}
            aria-label={card.title}
          >
            <div class="hub-card-bar">
              <h2 class="hub-card-bar-title">{card.title}</h2>
            </div>
            <div class="hub-card-body">
              <p class="hub-card-sub">{card.description}</p>
              <div class="hub-card-footer">
                <span class="hub-card-stakes">{card.stakes}</span>
                <span class="hub-card-pill pill--explore">Explore</span>
              </div>
            </div>
          </a>
        ) : (
          <div class:list={['hub-card', 'hub-card--next', categoryClass]}>
            <div class="hub-card-bar">
              <h2 class="hub-card-bar-title">{card.title}</h2>
            </div>
            <div class="hub-card-body">
              <p class="hub-card-sub">{card.description}</p>
              <div class="hub-card-footer">
                <span class="hub-card-stakes">{card.stakes}</span>
                <span class="hub-card-pill pill--coming-soon">Coming soon</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</main>

<footer class="hub-footer" role="contentinfo">
  <div class="hub-footer-inner">
    <div class="hub-footer-left">
      <div class="hub-footer-brand"><span>Alterrell</span> Interactive</div>
      <div class="hub-footer-credit">&copy; 2026 &middot; interactive.alterrell.com &middot; Data as Dignity</div>
    </div>
    <div class="hub-footer-right">
      <a href="https://ko-fi.com/alterrell" target="_blank" rel="noopener" class="hub-footer-link hub-footer-link--support">$ Support</a>
      <a href="https://alterrell.substack.com/s/alterrell-interactive" target="_blank" rel="noopener" class="hub-footer-link">Substack</a>
      <a href="https://www.youtube.com/playlist?list=PLBmJd1HY9o6YvRW5PDW0jOGJley2AjNYS" target="_blank" rel="noopener" class="hub-footer-link">YouTube</a>
    </div>
  </div>
</footer>

</body>
</html>
