---
/**
 * Dynamic piece route.
 *
 * Rest parameter ([...slug]) rather than a single segment ([slug]/index):
 * a single segment cannot express a multi-part series, because the slug
 * "naming/part-0" contains a separator and a [slug] route only ever matches
 * one. With the rest form, a content file at
 * src/content/pieces/naming/part-0.mdx builds to /naming/part-0/ with no
 * further routing work.
 *
 * Each file in src/content/pieces/ gets a URL at its own path.
 * Coming-soon pieces are built too (no 404), but the hub card is not linked.
 */
import { getCollection, render } from 'astro:content';
import PieceLayout from '../layouts/PieceLayout.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('pieces');
  return pieces.map((piece) => ({
    // In Astro v5 legacy collections, piece.id includes the .mdx extension.
    // Nested files keep their directory in the id, so stripping only the
    // extension preserves "naming/part-0" as a multi-segment slug.
    params: { slug: (piece as any).slug ?? piece.id.replace(/\.mdx?$/, '') },
    props:  { piece },
  }));
}

const { piece } = Astro.props;
const { Content } = await render(piece);
---
<PieceLayout piece={piece}>
  <Content />
</PieceLayout>
